generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Rsvp {
  id           String   @id @default(cuid())
  name         String
  attending    Boolean
  intolerances String?
  message      String?
  createdAt    DateTime @default(now())
}
