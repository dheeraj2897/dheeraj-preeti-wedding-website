# --- Database (PostgreSQL — required for Vercel; use Neon, Supabase, or Vercel Postgres) ---
# Example (Neon): postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- SMTP (RSVP notifications) ---
# Use any SMTP provider (Gmail App Password, Resend, SendGrid, Mailgun, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Where to deliver RSVP notifications
RSVP_NOTIFY_TO="dheeraj@example.com"
RSVP_NOTIFY_FROM="Dheeraj & Preethi Wedding <your-email@gmail.com>"
